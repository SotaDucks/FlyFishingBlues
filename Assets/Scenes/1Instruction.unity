--- !u!114 &645799984
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 645799983}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 490e5e9cc3941dd488c07062639ce3b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 361004055}
  backgroundImage: {fileID: 361004057}
  characterImage: {fileID: 635007924}
  dialogueText: {fileID: 345645999}
  dialogueNodes:
  - text: '[Take out] the rod'
    background: {fileID: 21300000, guid: 4296ea4dd5c545f4ea1d4ff7012cf425, type: 3}
    characterImage: {fileID: 21300000, guid: 7523220c7bb65af419557f9f30d92d6b, type: 3}
    progressType: 0
    actionName: SwitchToRod
    collisionTag: 
    autoDelay: 0
  - text: Cast it [back]. Let the line load with the swing.
    background: {fileID: 21300000, guid: 4296ea4dd5c545f4ea1d4ff7012cf425, type: 3}
    characterImage: {fileID: 21300000, guid: 3e375f2140530bb448d3fb1d7a11f98f, type: 3}
    progressType: 0
    actionName: CastBack
    collisionTag: 
    autoDelay: 0
  - text: 'Cast the rod [forward]. '
    background: {fileID: 21300000, guid: 4296ea4dd5c545f4ea1d4ff7012cf425, type: 3}
    characterImage: {fileID: 21300000, guid: 6f9b58d67bb27e8458212091770e9a8a, type: 3}
    progressType: 0
    actionName: CastForward
    collisionTag: 
    autoDelay: 0
  - text: To the teddy! You do know you can still walk when casting right?
    background: {fileID: 21300000, guid: 4296ea4dd5c545f4ea1d4ff7012cf425, type: 3}
    characterImage: {fileID: 21300000, guid: 67aec94749f69154fbfda488b170812c, type: 3}
    progressType: 1
    actionName: 
    collisionTag: Bear
    autoDelay: 0
  - text: 'Good! Let''s pull it to the sign. '
    background: {fileID: 21300000, guid: 4296ea4dd5c545f4ea1d4ff7012cf425, type: 3}
    characterImage: {fileID: 21300000, guid: a5d782b36b9b0034c920bd4e2aa20feb, type: 3}
    progressType: 1
    actionName: 
    collisionTag: Sign
    autoDelay: 0
  - text: When the hook is empty, you can quickly [reel in] your line.
    background: {fileID: 21300000, guid: 4296ea4dd5c545f4ea1d4ff7012cf425, type: 3}
    characterImage: {fileID: 21300000, guid: 18aa3ec0d3caf184bba87493b9fdf74d, type: 3}
    progressType: 0
    actionName: EndFishing
    collisionTag: 
    autoDelay: 0
  - text: '[Put away] the rod'
    background: {fileID: 21300000, guid: 4296ea4dd5c545f4ea1d4ff7012cf425, type: 3}
    characterImage: {fileID: 21300000, guid: 10d96879b39305140a9e64fb7fd4c2cf, type: 3}
    progressType: 0
    actionName: SwitchToNoRod
    collisionTag: 
    autoDelay: 0
  - text: "Go check the trouts\u2014sea to the north, stream to the east of the town."
    background: {fileID: 21300000, guid: 4296ea4dd5c545f4ea1d4ff7012cf425, type: 3}
    characterImage: {fileID: 21300000, guid: 10d96879b39305140a9e64fb7fd4c2cf, type: 3}
    progressType: 2
    actionName: 
    collisionTag: 
    autoDelay: 0
  playerInput: {fileID: 8119966058644733228}
